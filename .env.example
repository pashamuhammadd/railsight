# Copy this file to .env.local (for apps/web, Next.js convention) and to
# packages/ingestion/.env (the ingestion worker loads its own .env via
# dotenv) — or symlink one to the other. Never commit the filled-in file.

# --- Required ---

# Supabase (or any Postgres) connection string.
# Supabase free tier: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgres://postgres:password@localhost:5432/railsight

# Helius free-tier API key: helius.dev -> sign up -> API key.
HELIUS_API_KEY=

# --- Optional ---

# Falls back to the public Solana RPC if unset. Not currently used by the
# ingestion service (which uses Helius's Enhanced Transactions API
# instead), reserved for direct RPC calls if/when needed.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How often the ingestion worker polls each tracked merchant, in ms.
POLL_INTERVAL_MS=60000

# Comma-separated wallet addresses to seed as tracked merchants on first
# run (local dev convenience only — see packages/ingestion/README.md).
SEED_MERCHANT_WALLETS=

# [TODO: confirm] Verified facilitator fee-payer pubkeys, as JSON.
# Leave empty until you've verified these yourself — see
# packages/ingestion/README.md for why there's no default value here and
# how to find them.
FACILITATOR_FEE_PAYERS={}

# Non-organic activity heuristic thresholds (TECH-SPEC.md section 4) — all
# optional, sensible defaults baked into packages/ingestion/src/config.ts.
# Tune these once there's real transaction volume to test against.
# HEURISTIC_IDENTICAL_AMOUNT_LOOP_THRESHOLD=10
# HEURISTIC_VOLUME_WINDOW_DAYS=7
# HEURISTIC_VOLUME_GROWTH_MULTIPLIER=2
# HEURISTIC_PAYER_GROWTH_ALLOWANCE=1
# HEURISTIC_MIN_CURRENT_PERIOD_TX_COUNT=10

# Auto-discovery of Solana x402 merchants via Coinbase CDP's public Bazaar
# directory (see packages/ingestion/src/discovery.ts and its README
# section). On by default — set to "false" to disable if the Bazaar API
# is unreachable or misbehaving.
# ENABLE_BAZAAR_DISCOVERY=true

# How often the always-on ingestion worker loop (npm run dev / npm start
# in packages/ingestion) re-checks the Bazaar, in ms. Not used by the
# Vercel Cron path (apps/web), which re-checks every invocation instead.
# BAZAAR_DISCOVERY_INTERVAL_MS=3600000

# [TODO: confirm] Delay between each merchant's Helius request within one
# poll cycle, in ms. Added after Bazaar discovery grew the tracked
# merchant list to 247 wallets and polling with no delay triggered 429
# Too Many Requests on nearly every request — we couldn't find/verify
# Helius's actual free-tier requests-per-second cap, so this default
# (300ms, ~3.3 req/s) is our own conservative starting point. Used by
# both packages/ingestion/src/poll.ts and apps/web/src/lib/ingest-cron.ts.
# HELIUS_REQUEST_DELAY_MS=300

# --- apps/web only (Vercel Cron ingestion, see apps/web/vercel.json) ---

# Optional shared secret for /api/cron/ingest — set this in Vercel's
# Project Settings -> Environment Variables (NOT here) once you're ready
# to make the deployment public, so a stranger can't trigger Helius API
# calls by hitting the cron URL directly. Vercel Cron sends this
# automatically as `Authorization: Bearer <value>` when it invokes the
# job. Leave unset for local/demo use.
# CRON_SECRET=

# Caps how many merchants one /api/cron/ingest invocation polls (a
# random subset each run, so coverage rotates across days) — needed
# because Vercel's function has a hard maxDuration (60s, see route.ts)
# and HELIUS_REQUEST_DELAY_MS makes a full pass over a large,
# Bazaar-grown merchant list take too long to fit. 80 x the ~300ms
# default delay ≈ 24s, leaving headroom for discovery + flagging.
# CRON_MERCHANT_LIMIT=80

# Consider setting this to "false" in Vercel's Project Settings (not
# here) once Bazaar discovery has run successfully at least once locally
# (`npm run discover` in packages/ingestion) — discovered merchants are
# already persisted in the shared Supabase DB, so the daily cron doesn't
# need to re-walk the Bazaar's ~250+ listings on every invocation too;
# skipping it there leaves more of the 60s budget for actually polling
# merchants. Leave it "true" (the default, see ENABLE_BAZAAR_DISCOVERY
# above) if you want new merchants to keep showing up automatically.
