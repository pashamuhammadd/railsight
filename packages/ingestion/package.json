{
  "name": "@railsight/ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone worker that pulls settled x402 USDC transfers on Solana (via Helius) into Postgres.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@railsight/shared": "*",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
