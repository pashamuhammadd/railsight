{
  "name": "railsight",
  "private": true,
  "version": "0.1.0",
  "description": "RailSight — Solana-native analytics and trust layer for the x402 payment protocol.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "ingest": "npm run start --workspace=packages/ingestion",
    "ingest:dev": "npm run dev --workspace=packages/ingestion"
  },
  "engines": {
    "node": ">=20"
  }
}
